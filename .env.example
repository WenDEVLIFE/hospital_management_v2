# ---------------------------------------------------------------------------
# UI PREVIEW MODE
# When enabled, pages render synthetic preview rows so the interface can be
# reviewed end-to-end. Preview rows are NOT hospital records.
# Set to "false" to render pure empty states instead.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_UI_PREVIEW=true

# ---------------------------------------------------------------------------
# Supabase (placeholders only — never commit real credentials)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# EDGE FUNCTION SECRETS (server-side only)
# These do NOT belong in .env.local or any NEXT_PUBLIC_ variable.
# Configure with: supabase secrets set ... (see supabase/functions/README.md)
# ---------------------------------------------------------------------------
# HMS_NOTIFICATION_TOKEN=
# HMS_MAINTENANCE_TOKEN=
# HMS_SMTP_USER=
# HMS_SMTP_APP_PASSWORD=
